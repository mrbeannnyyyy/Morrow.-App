import {contextBridge,ipcRenderer} from 'electron';
contextBridge.exposeInMainWorld('morrow',{list:()=>ipcRenderer.invoke('browser:list'),layout:(open:boolean,width:number,sideTabs:boolean,updateNotice=false)=>ipcRenderer.invoke('browser:layout',open,width,sideTabs,updateNotice),searchSuggestions:(query:string)=>ipcRenderer.invoke('browser:search-suggestions',query),checkForUpdates:()=>ipcRenderer.invoke('browser:check-updates'),openUpdatePage:(isPrerelease=false)=>ipcRenderer.invoke('browser:open-update-page',isPrerelease),getAppVersion:()=>ipcRenderer.invoke('browser:app-version'),getReleaseNotes:(version:string)=>ipcRenderer.invoke('browser:release-notes',version),openReleaseNotes:(version:string,isPrerelease=false)=>ipcRenderer.invoke('browser:open-release-notes',version,isPrerelease),isDefaultBrowser:()=>ipcRenderer.invoke('browser:is-default-browser'),setDefaultBrowser:()=>ipcRenderer.invoke('browser:set-default-browser'),newTab:(url?:string)=>ipcRenderer.invoke('browser:new',url),activate:(id:string)=>ipcRenderer.invoke('browser:activate',id),close:(id:string)=>ipcRenderer.invoke('browser:close',id),navigate:(url:string)=>ipcRenderer.invoke('browser:navigate',url),back:()=>ipcRenderer.invoke('browser:back'),forward:()=>ipcRenderer.invoke('browser:forward'),reload:()=>ipcRenderer.invoke('browser:reload'),home:()=>ipcRenderer.invoke('browser:home'),moreMenu:()=>ipcRenderer.invoke('browser:more-menu'),profileMenu:()=>ipcRenderer.invoke('browser:profile-menu'),importBrowser:(source:string)=>ipcRenderer.invoke('browser:import-source',source),openICloudHelp:()=>ipcRenderer.invoke('browser:open-icloud-help'),on:(event:string,fn:(...args:any[])=>void)=>{const allowed=['browser:created','browser:activated','browser:closed','browser:state','browser:favicon','browser:error','browser:failure','browser:focus-address','browser:menu-action'];if(allowed.includes(event)){const listener: typeof fn=(_e,...args)=>fn(...args);ipcRenderer.on(event,listener);return()=>ipcRenderer.removeListener(event,listener)}return()=>{}}});
